ue Representation","identifiesControllerService":false,"sensitive":false},"camera.request_id":{"name":"camera.request_id","displayName":"camera.request_id","identifiesControllerService":false,"sensitive":false},"Path Not Found Behavior":{"name":"Path Not Found Behavior","displayName":"Path Not Found Behavior","identifiesControllerService":false,"sensitive":false}},"style":{},"schedulingPeriod":"0 sec","schedulingStrategy":"TIMER_DRIVEN","executionNode":"ALL","penaltyDuration":"30 sec","yieldDuration":"1 sec","bulletinLevel":"WARN","runDurationMillis":0,"concurrentlySchedulableTaskCount":1,"autoTerminatedRelationships":["unmatched"],"scheduledState":"ENABLED","retryCount":10,"retriedRelationships":[],"backoffMechanism":"PENALIZE_FLOWFILE","maxBackoffPeriod":"10 mins","componentType":"PROCESSOR","groupIdentifier":"29c28b59-e36a-3446-82e0-7b52c43f003f"},{"identifier":"6c74a73e-7eb9-37ad-927f-5b8b6dde3211","instanceIdentifier":"20df689d-01a1-1000-8a4b-f352ca6577b5","name":"ExecuteScript-ValidateImage","comments":"","position":{"x":1240.0,"y":216.0},"type":"org.apache.nifi.processors.script.ExecuteScript","bundle":{"group":"org.apache.nifi","artifact":"nifi-scripting-nar","version":"1.27.0"},"properties":{"Script File":null,"Script Engine":"Groovy","Script Body":"import groovy.json.JsonSlurper\nimport org.apache.nifi.processor.io.InputStreamCallback\nimport javax.imageio.ImageIO\nimport javax.imageio.stream.MemoryCacheImageInputStream\nimport java.nio.charset.StandardCharsets\nimport java.security.MessageDigest\nimport java.util.Base64\n\nclass ImageValidationFailure extends RuntimeException {\n    ImageValidationFailure(String code) {\n        super(code)\n    }\n}\n\ndef flowFile = session.get()\nif (flowFile == null) {\n    return\n}\n\nfinal long MAX_JSON_BYTES = 20L * 1024 * 1024\nfinal long MAX_IMAGE_BYTES = 10L * 1024 * 1024\nfinal long MAX_PIXELS = 16_000_000L\nfinal long MAX_BASE64_LENGTH = 4L * ((MAX_IMAGE_BYTES + 2L) / 3L)\n\ndef reject = { String code ->\n    throw new ImageValidationFailure(code)\n}\n\ntry {\n    if (flowFile.getSize() > MAX_JSON_BYTES) {\n        reject(\"JSON_TOO_LARGE\")\n    }\n\n    String body = \"\"\n    session.read(flowFile, { inputStream ->\n        body = inputStream.getText(StandardCharsets.UTF_8.name())\n    } as InputStreamCallback)\n\n    def payload\n    try {\n        payload = new JsonSlurper().parseText(body)\n    } catch (Exception ignored) {\n        reject(\"INVALID_JSON\")\n    }\n\n    if (!(payload instanceof Map)) {\n        reject(\"INVALID_JSON_OBJECT\")\n    }\n\n    def value = payload.get(\"image_base64\")\n\n    if (!(value instanceof String) || value.trim().isEmpty()) {\n        reject(\"MISSING_IMAGE_BASE64\")\n    }\n\n    String encoded = value\n\n    if (encoded.length() > MAX_BASE64_LENGTH) {\n        reject(\"IMAGE_TOO_LARGE\")\n    }\n\n    // Standard Base64 only: no data URI, whitespace or URL-safe alphabet.\n    if (encoded.length() % 4 != 0 ||\n        !(encoded ==~ /[A-Za-z0-9+\\/]*={0,2}/)) {\n        reject(\"INVALID_BASE64\")\n    }\n\n    byte[] imageBytes\n    try {\n        imageBytes = Base64.getDecoder().decode(encoded)\n    } catch (IllegalArgumentException ignored) {\n        reject(\"INVALID_BASE64\")\n    }\n\n    if (Base64.getEncoder().encodeToString(imageBytes) != encoded) {\n        reject(\"INVALID_BASE64\")\n    }\n\n    if (imageBytes.length == 0) {\n        reject(\"EMPTY_IMAGE\")\n    }\n\n    if (imageBytes.length > MAX_IMAGE_BYTES) {\n        reject(\"IMAGE_TOO_LARGE\")\n    }\n\n    int width = 0\n    int height = 0\n    String format = \"\"\n\n    def imageInput = new MemoryCacheImageInputStream(\n        new ByteArrayInputStream(imageBytes)\n    )\n    def reader = null\n\n    try {\n        def readers = ImageIO.getImageReaders(imageInput)\n\n        if (!readers.hasNext()) {\n            reject(\"INVALID_OR_UNSUPPORTED_IMAGE\")\n        }\n\n        reader = readers.next()\n        format = reader.getFormatName().toUpperCase(Locale.ROOT)\n\n        if (!(format in [\"PNG\", \"JPEG\", \"JPG\"])) {\n            reject(\"UNSUPPORTED_IMAGE_FORMAT\")\n        }\n\n        if (format == \"JPG\") {\n            format = \"JPEG\"\n        }\n\n        reader.setInput(imageInput, false, false)\n        width = reader.getWidth(0)\n        height = reader.getHeight(0)\n\n        if (width <= 0 || height <= 0) {\n            reject(\"INVALID_IMAGE_DIMENSIONS\")\n        }\n\n        if ((long) width * (long) height > MAX_PIXELS) {\n            reject(\"IMAGE_TOO_MANY_PIXELS\")\n        }\n\n        def decoded = reader.read(0)\n\n        if (decoded == null ||\n            decoded.getWidth() != width ||\n            decoded.getHeight() != height) {\n            reject(\"INVALID_IMAGE\")\n        }\n\n        decoded.flush()\n    } catch (IOException ignored) {\n        reject(\"INVALID_IMAGE\")\n    } finally {\n        if (reader != null) {\n            reader.dispose()\n        }\n        imageInput.close()\n    }\n\n    String sha256 = MessageDigest.getInstance(\"SHA-256\")\n        .digest(imageBytes)\n        .encodeHex()\n        .toString()\n\n    flowFile = session.removeAttribute(flowFile, \"quarantine.reason\")\n\n    flowFile = session.putAllAttributes(flowFile, [\n        \"image.validation.status\" : \"VALID\",\n        \"image.validation.version\": \"camera-image-v0.1\",\n        \"image.format\"            : format,\n        \"image.mime_type\"         : format == \"PNG\"\n            ? \"image/png\" : \"image/jpeg\",\n        \"image.width\"             : Integer.toString(width),\n        \"image.height\"            : Integer.toString(height),\n        \"image.size_bytes\"        : Integer.toString(imageBytes.length),\n        \"image.sha256\"            : sha256\n    ])\n\n    session.transfer(flowFile, REL_SUCCESS)\n\n} catch (ImageValidationFailure failure) {\n    flowFile = session.putAllAttributes(flowFile, [\n        \"image.validation.status\" : \"INVALID\",\n        \"image.validation.version\": \"camera-image-v0.1\",\n        \"quarantine.reason\"       : failure.getMessage()\n    ])\n\n    session.transfer(flowFile, REL_FAILURE)\n}","Module Directory":null},"propertyDescriptors":{"Script File":{"name":"Script File","displayName":"Script File","identifiesControllerService":false,"sensitive":false,"resourceDefinition":{"cardinality":"SINGLE","resourceTypes":["FILE"]}},"Script Engine":{"name":"Script Engine","displayName":"Script Engine","identifiesControllerService":false,"sensitive":false},"Script Body":{"name":"Script Body","displayName":"Script Body","identifiesControllerService":false,"sensitive":false},"Module Directory":{"name":"Module Directory","displayName":"Module Directory","identifiesControllerService":false,"sensitive":false,"resourceDefinition":{"cardinality":"MULTIPLE","resourceTypes":["FILE","DIRECTORY"]}}},"style":{},"schedulingPeriod":"0 sec","schedulingStrategy":"TIMER_DRIVEN","executionNode":"ALL","penaltyDuration":"30 sec","yieldDuration":"1 sec","bulletinLevel":"WARN","runDurationMillis":0,"concurrentlySchedulableTaskCount":1,"autoTerminatedRelationships":[],"scheduledState":"ENABLED","retryCount":10,"retriedRelationships":[],"backoffMechanism":"PENALIZE_FLOWFILE","maxBackoffPeriod":"10 mins","componentType":"PROCESSOR","groupIdentifier":"29c28b59-e36a-3446-82e0-7b52c43f003f"},{"identifier":"f65f0951-3c7e-3c22-b581-0b4041bb187a","instanceIdentifier":"20fe1703-01a1-1000-3e65-791b8ac8f495","name":"ExecuteScript-PrepareMultipart","comments":"","position":{"x":1408.0,"y":-48.0},"type":"org.apache.nifi.processors.script.ExecuteScript","bundle":{"group":"org.apache.nifi","artifact":"nifi-scripting-nar","version":"1.27.0"},"properties":{"Script File":null,"Script Engine":"Groovy","Script Body":"import groovy.json.JsonSlurper\nimport org.apache.nifi.processor.io.InputStreamCallback\nimport org.apache.nifi.processor.io.OutputStreamCallback\nimport java.nio.charset.StandardCharsets\nimport java.security.MessageDigest\nimport java.util.Base64\n\nclass MultipartValidationFailure extends RuntimeException {\n    MultipartValidationFailure(String code) {\n        super(code)\n    }\n}\n\ndef flowFile = session.get()\nif (flowFile == null) {\n    return\n}\n\ndef reject = { String code ->\n    throw new MultipartValidationFailure(code)\n}\n\nfinal long MAX_JSON_BYTES = 20L * 1024 * 1024\nfinal long MAX_IMAGE_BYTES = 10L * 1024 * 1024\n\nfinal String UUID_PATTERN =\n    '^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'\n\ntry {\n    if (flowFile.getAttribute(\"image.validation.status\") != \"VALID\") {\n        reject(\"IMAGE_NOT_VALIDATED\")\n    }\n\n    if (flowFile.getSize() > MAX_JSON_BYTES) {\n        reject(\"JSON_TOO_LARGE\")\n    }\n\n    String body = \"\"\n    session.read(flowFile, { inputStream ->\n        body = inputStream.getText(StandardCharsets.UTF_8.name())\n    } as InputStreamCallback)\n\n    def payload\n    try {\n        payload = new JsonSlurper().parseText(body)\n    } catch (Exception ignored) {\n        reject(\"INVALID_JSON\")\n    }\n\n    if (!(payload instanceof Map)) {\n        reject(\"INVALID_JSON_OBJECT\")\n    }\n\n    def requestId = payload.get(\"request_id\")\n    def patientId = payload.get(\"patient_id\")\n    def modality = payload.get(\"modality\")\n    def eyeSide = payload.get(\"eye_side\")\n    def encoded = payload.get(\"image_base64\")\n\n    if (!(requestId instanceof String) ||\n        !(requestId ==~ UUID_PATTERN)) {\n        reject(\"INVALID_REQUEST_ID\")\n    }\n\n    if (!(patientId instanceof String) ||\n        !(patientId ==~ UUID_PATTERN)) {\n        reject(\"INVALID_PATIENT_ID\")\n    }\n\n    if (modality != \"FUNDUS\") {\n        reject(\"UNSUPPORTED_MODALITY\")\n    }\n\n    if (!(eyeSide in [\"left\", \"right\", \"unknown\"])) {\n        reject(\"INVALID_EYE_SIDE\")\n    }\n\n    if (!(encoded instanceof String) || encoded.isEmpty()) {\n        reject(\"MISSING_IMAGE_BASE64\")\n    }\n\n    byte[] imageBytes\n    try {\n        imageBytes = Base64.getDecoder().decode(encoded)\n    } catch (IllegalArgumentException ignored) {\n        reject(\"INVALID_BASE64\")\n    }\n\n    if (imageBytes.length == 0 ||\n        imageBytes.length > MAX_IMAGE_BYTES) {\n        reject(\"INVALID_IMAGE_SIZE\")\n    }\n\n    String actualHash = MessageDigest.getInstance(\"SHA-256\")\n        .digest(imageBytes)\n        .encodeHex()\n        .toString()\n\n    if (actualHash != flowFile.getAttribute(\"image.sha256\")) {\n        reject(\"IMAGE_CHECKSUM_MISMATCH\")\n    }\n\n    String format = flowFile.getAttribute(\"image.format\")\n\n    if (!(format in [\"JPEG\", \"PNG\"])) {\n        reject(\"UNSUPPORTED_IMAGE_FORMAT\")\n    }\n\n    String mediaType = format == \"PNG\"\n        ? \"image/png\" : \"image/jpeg\"\n\n    String extension = format == \"PNG\" ? \"png\" : \"jpg\"\n    String imageName = \"image.\" + extension\n    String boundary = \"aura-\" + flowFile.getAttribute(\"uuid\")\n\n    def multipart = new ByteArrayOutputStream()\n\n    def appendText = { String text ->\n        byte[] bytes = text.getBytes(StandardCharsets.UTF_8)\n        multipart.write(bytes, 0, bytes.length)\n    }\n\n    def appendField = { String name, String value ->\n        appendText(\"--\" + boundary + \"\\r\\n\")\n        appendText(\n            \"Content-Disposition: form-data; name=\\\"\" +\n            name + \"\\\"\\r\\n\"\n        )\n        appendText(\"\\r\\n\" + value + \"\\r\\n\")\n    }\n\n    appendField(\"patientId\", patientId)\n    appendField(\"modality\", modality)\n    appendField(\"eyeSide\", eyeSide)\n\n    appendText(\"--\" + boundary + \"\\r\\n\")\n    appendText(\n        \"Content-Disposition: form-data; name=\\\"images\\\"; \" +\n        \"filename=\\\"\" + imageName + \"\\\"\\r\\n\"\n    )\n    appendText(\"Content-Type: \" + mediaType + \"\\r\\n\\r\\n\")\n\n    multipart.write(imageBytes, 0, imageBytes.length)\n    appendText(\"\\r\\n--\" + boundary + \"--\\r\\n\")\n\n    byte[] preparedBody = multipart.toByteArray()\n\n    flowFile = session.write(flowFile, { outputStream ->\n        outputStream.write(preparedBody)\n    } as OutputStreamCallback)\n\n    flowFile = session.removeAttribute(flowFile, \"quarantine.reason\")\n\n    flowFile = session.putAllAttributes(flowFile, [\n        \"mime.type\"               :\n            \"multipart/form-data; boundary=\" + boundary,\n        \"filename\"                :\n            flowFile.getAttribute(\"uuid\") + \".multipart\",\n        \"gateway.idempotency_key\" : requestId,\n        \"gateway.correlation_id\"  : requestId,\n        \"gateway.patient_id\"      : patientId,\n        \"gateway.retry_count\"     : \"0\",\n        \"gateway.payload.version\": \"analysis-multipart-v0.1\",\n        \"gateway.payload.ready\"   : \"true\"\n    ])\n\n    session.transfer(flowFile, REL_SUCCESS)\n\n} catch (MultipartValidationFailure failure) {\n    flowFile = session.putAllAttributes(flowFile, [\n        \"gateway.payload.ready\": \"false\",\n        \"quarantine.reason\"    : failure.getMessage()\n    ])\n\n    session.transfer(flowFile, REL_FAILURE)\n}","Module Directory":null},"propertyDescriptors":{"Script File":{"name":"Script File","displayName":"Script File","identifiesControllerService":false,"sensitive":false,"resourceDefinition":{"cardinality":"SINGLE","resourceTypes":["FILE"]}},"Script Engine":{"name":"Script Engine","displayName":"Script Engine","identifiesControllerService":false,"sensitive":false},"Script Body":{"name":"Script Body","displayName":"Script Body","identifiesControllerService":false,"sensitive":false},"Module Directory":{"name":"Module Directory","displayName":"Module Directory","identifiesControllerService":false,"sensitive":false,"resourceDefinition":{"cardinality":"MULTIPLE","resourceTypes":["FILE","DIRECTORY"]}}},"style":{},"schedulingPeriod":"0 sec","schedulingStrategy":"TIMER_DRIVEN","executionNode":"ALL","penaltyDuration":"30 sec","yieldDuration":"1 sec","bulle