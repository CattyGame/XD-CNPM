  "policies": [
    {
      "vhost": "/aura-s3",
      "name": "jobs-safety",
      "pattern": "^aura\\.s3\\.analysis\\.jobs$",
      "apply-to": "quorum_queues",
      "priority": 10,
      "definition": {
        "dead-letter-exchange": "aura.s3.dead.jobs",
        "dead-letter-routing-key": "jobs",
        "dead-letter-strategy": "at-least-once",
        "overflow": "reject-publish",
        "delivery-limit": 3,
        "max-length": 10000,
        "max-length-bytes": 67108864
      }
    },
    {
      "vhost": "/aura-s3",
      "name": "jobs-delay",
      "pattern": "^aura\\.s3\\.retry\\.jobs$",
      "apply-to": "quorum_queues",
      "priority": 10,
      "definition": {
        "message-ttl": 5000,
        "dead-letter-exchange": "aura.s3.retry.return",
        "dead-letter-routing-key": "jobs",
        "dead-letter-strategy": "at-least-once",
        "overflow": "reject-publish",
        "delivery-limit": 3,
        "max-length": 10000,
        "max-length-bytes": 67108864
