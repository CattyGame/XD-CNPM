  "permissions": [
    {
      "user": "s3-publisher",
      "configure": "^$",
      "write": "^aura\\.s3\\.(jobs|events)$",
      "read": "^$",
      "vhost": "/aura-s3"
    },
    {
      "user": "s3-worker",
