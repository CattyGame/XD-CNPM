# Public configuration template. Copy to .env.local (ignored), never to the old runtime.
AURA_S3_PROJECT=aura-s3-yourname
# Required: provisioned directory OUTSIDE this repository, issued by M1/M6.
# Existing sprint3-v1 material on M1's machine must not be regenerated or copied wholesale.
AURA_S3_AUTH_HOME=

# Target integration catalogue below; not all services are deployed by this handoff.
AURA_S3_IDENTITY_URL=http://identity-api:8080
AURA_S3_PROFILE_URL=http://profile-api:8080
AURA_S3_ANALYSIS_URL=http://analysis-api:8080
AURA_S3_AI_URL=http://ai-core:8000
AURA_S3_DB_HOST=postgres
AURA_S3_DB_PORT=5432
AURA_S3_DB_NAME=aura_s3_yourname
AURA_S3_RABBIT_HOST=rabbitmq
AURA_S3_RABBIT_PORT=5672
AURA_S3_RABBIT_VHOST=/aura-s3
AURA_S3_ISSUER=aura-identity-s3-v1
AURA_S3_AI_AUDIENCE=aura-ai
AURA_S3_AI_SCOPE=ai:analyze
# Feature gates remain closed until the separate integration review passes.
AURA_S3_PUBLISHER_ENABLED=false
AURA_S3_WORKER_ENABLED=false

# No passwords, client secrets, JWTs or signing key contents belong in this file.
# Actual .NET publisher keys: Outbox__Enabled, RabbitMq__User/Password,
# ConnectionStrings__OutboxPublisher. The catalogue above is not auto-bound to them.
