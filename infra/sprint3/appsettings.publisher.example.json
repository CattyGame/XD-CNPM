{
  "Outbox": {
    "Enabled": false,
    "PollSeconds": 5,
    "BatchSize": 10,
    "MaxPublishAttempts": 10,
    "ConfirmTimeoutSeconds": 5,
    "LeaseSeconds": 60,
    "MaxBodyBytes": 65536,
    "BackoffSeconds": [5, 15, 30, 60, 120],
    "MinOccurredAtUtc": null,
    "ExcludedTenantIds": [],
    "JobsExchange": "aura.s3.jobs",
    "EventsExchange": "aura.s3.events"
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672,
    "VirtualHost": "/aura-s3",
    "ConnectionTimeoutSeconds": 5
  }
}
