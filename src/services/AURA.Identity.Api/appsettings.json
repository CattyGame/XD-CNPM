    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=127.0.0.1;Port=5432;Database=aura_dev;Username=aura_identity_app;Password=aura_identity_pass;Timeout=5;Command Timeout=10"
  },
