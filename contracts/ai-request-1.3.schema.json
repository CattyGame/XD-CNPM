{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AURA AI Analysis Request Contract 1.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "patient_id",
    "eye_side",
    "mode",
    "modality",
    "image_base64",
    "include_mask",
    "include_overlay"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "patient_id": {
      "type": "null",
      "description": "Must remain null on Worker -> AI Core transport to enforce PHI minimization."
    },
    "eye_side": {
      "enum": [
        "left",
        "right",
        "unknown"
      ]
    },
    "mode": {
      "const": "retina_vessels"
    },
    "modality": {
      "const": "FUNDUS"
    },
    "image_base64": {
      "type": "string",
      "minLength": 4,
      "maxLength": 13981016,
      "contentEncoding": "base64"
    },
    "include_mask": {
      "const": true
    },
    "include_overlay": {
      "const": true
    }
  }
}
